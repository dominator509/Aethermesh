{
  "title": "L3 Handshake",
  "uid": "aep-l3-handshake",
  "panels": [
    {
      "title": "Handshake duration (p95)",
      "targets": [{"expr": "histogram_quantile(0.95, rate(aep_l3_handshake_duration_seconds_bucket[5m]))"}],
      "type": "graph"
    },
    {
      "title": "Handshake success rate",
      "targets": [{"expr": "sum(rate(aep_l3_handshake_duration_seconds_count{result='success'}[5m])) / sum(rate(aep_l3_handshake_duration_seconds_count[5m]))"}],
      "type": "stat"
    },
    {
      "title": "Attestation verifications by backend",
      "targets": [{"expr": "rate(aep_l3_attestation_verifications_total[1m])"}],
      "type": "graph"
    }
  ]
}
