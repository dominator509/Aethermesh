{
  "title": "L1 Transport",
  "uid": "aep-l1-transport",
  "panels": [
    {
      "title": "Packets per second",
      "targets": [{"expr": "rate(aep_l1_packets_total[1m])"}],
      "type": "graph"
    },
    {
      "title": "Lane latency",
      "targets": [{"expr": "histogram_quantile(0.95, rate(aep_l1_lane_latency_seconds_bucket[5m]))"}],
      "type": "graph"
    },
    {
      "title": "Replay rejections",
      "targets": [{"expr": "rate(aep_l1_sphinx_replay_rejections_total[1m])"}],
      "type": "graph"
    }
  ]
}
